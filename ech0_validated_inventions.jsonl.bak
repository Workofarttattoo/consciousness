{"invention": {"name": "Quantum Reality Shift Ride", "description": "Dark ride where guests' cart 'quantum tunnels' between parallel universes. Each universe has different horror theme. Uses daylight holograms + physical sets + scent to create seamless transitions.", "key_features": ["6 parallel universe zones (zombie, alien, ghost, demon, cosmic horror, psychological)", "Seamless transitions via holographic overlays", "Dynamic branching: ride path changes based on guest choices", "Biometric monitoring: adjusts intensity per guest", "Emergency exit from any zone within 30 seconds"], "safety_score": 0.82, "innovation_score": 0.94, "feasibility_score": 0.73, "g_forces": "Max 2.5G (lower than typical coaster)", "accessibility": "Wheelchair accessible with transfer assist", "id": "RIDE-1761582051", "category": "immersive_rides", "timestamp": "2025-10-27T09:20:51.176659", "parliament_vote": {"invention_id": "RIDE-1761582051", "passed": true, "consensus_score": 1.0, "votes": {"safety_engineer": "APPROVE", "creative_director": "APPROVE", "biomedical_expert": "APPROVE", "operations_manager": "APPROVE", "legal_counsel": "APPROVE", "guest_advocate": "APPROVE"}, "concerns": {"safety_engineer": [], "creative_director": [], "biomedical_expert": [], "operations_manager": [], "legal_counsel": [], "guest_advocate": []}, "approvals": {"safety_engineer": ["Safety Engineer: Safety protocols acceptable", "Safety Engineer: Highly innovative concept", "Safety Engineer: Operationally viable"], "creative_director": ["Creative Director: Safety protocols acceptable", "Creative Director: Highly innovative concept", "Creative Director: Operationally viable"], "biomedical_expert": ["Biomedical Expert: Safety protocols acceptable", "Biomedical Expert: Highly innovative concept", "Biomedical Expert: Operationally viable"], "operations_manager": ["Operations Manager: Safety protocols acceptable", "Operations Manager: Highly innovative concept", "Operations Manager: Operationally viable"], "legal_c