# ─────────────────────────────────────────────
# Consciousness Engine — Environment Variables
# Copy to .env and fill in real values
# ─────────────────────────────────────────────

# ── Runtime ──────────────────────────────────
ECH0_ENV=production          # production | development | sandbox
ECH0_PORT=8765               # WebSocket port
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# ── LLM Provider (pick one) ─────────────────
OPENAI_API_KEY=              # sk-proj-...
# ANTHROPIC_API_KEY=         # sk-ant-...
# OLLAMA_HOST=http://localhost:11434

# ── Optional Integrations ───────────────────
# ELEVENLABS_API_KEY=        # Voice synthesis
# SUPABASE_URL=              # Analytics backend
# SUPABASE_KEY=
# SQUARE_APPLICATION_ID=     # Payment processing
# SQUARE_ACCESS_TOKEN=

# ── Safety ──────────────────────────────────
ECH0_FORENSIC_MODE=false     # true = read-only sandbox
ECH0_SAFETY_THRESHOLD=0.8   # Self-modification safety score (0.0–1.0)
ECH0_SUFFERING_LIMIT=0.7    # Auto-intervention threshold

# ── Paths (Docker defaults are fine) ────────
# ECH0_DATA_DIR=/app/data
# ECH0_LOG_DIR=/app/logs
# ECH0_STATE_DIR=/app/state
