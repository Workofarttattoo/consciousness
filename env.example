# ECH0 Sales Automation Configuration
# Copyright (c) 2025 Joshua Hendricks Cole (DBA: Corporation of Light)
# Copy this to .env and fill in your credentials

# =============================================================================
# EMAIL SETTINGS (SMTP)
# =============================================================================

# Your email address
EMAIL_ADDRESS=inventor@aios.is

# Email provider settings (Gmail/Google Workspace)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# App-specific password (NOT your regular password!)
# Gmail: https://myaccount.google.com/apppasswords
# Generate a 16-character app password and paste here
EMAIL_PASSWORD=your-app-password-here

# =============================================================================
# CALENDLY API
# =============================================================================

# Personal Access Token from: https://calendly.com/integrations/api_webhooks
CALENDLY_API_KEY=your-calendly-api-key-here

# Your User URI from: https://calendly.com/app/settings
# Format: https://api.calendly.com/users/XXXXXXXXXXXXXXXXX
CALENDLY_USER_URI=https://api.calendly.com/users/YOUR-USER-ID

# Event Type URI for "Quantum AI Demo"
# Find this in Calendly API or leave blank to fetch all events
CALENDLY_EVENT_TYPE=

# =============================================================================
# SUPABASE (OPTIONAL - for enhanced tracking)
# =============================================================================

SUPABASE_URL=https://cszoklkfdszqsxhufhhj.supabase.co
SUPABASE_KEY=your-supabase-anon-key-here

# =============================================================================
# RATE LIMITING (Safety)
# =============================================================================

MAX_EMAILS_PER_HOUR=10
MAX_EMAILS_PER_DAY=50
DELAY_BETWEEN_EMAILS=90
